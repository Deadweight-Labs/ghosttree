[Unit]
Description=ghosttree: Gärtner prüft Pitfalls und Decisions gegen den Code
After=ghosttree.service network-online.target ghosttree-garden-update.service
Wants=network-online.target ghosttree-garden-update.service
ConditionPathExists=/etc/ghosttree/garden-key
ConditionPathExists=/var/lib/ghosttree/garden/repo/.git

[Service]
Type=oneshot
User=ghosttree
Group=ghosttree
WorkingDirectory=/var/lib/ghosttree/garden
Environment=HOME=/var/lib/ghosttree/garden/home
Environment=GIT_CONFIG_GLOBAL=/var/lib/ghosttree/garden/gitconfig
EnvironmentFile=/etc/ghosttree/server.env
ExecStart=/var/lib/ghosttree/garden/run.sh
TimeoutStartSec=3h
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/ghosttree
# data: the database; reports: the morning report; claude: what Claude Code keeps
# for its sessions (settings.json, state, cache). Nothing else is writable.
ReadWritePaths=/var/lib/ghosttree/data /var/lib/ghosttree/garden/reports /var/lib/ghosttree/garden/claude
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Loopback only: the model proxy and the ghosttree server are on this machine.
# Against api.anthropic.com directly, replace these two lines with an allowlist
# of that address.
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Other processes (and their environments) are not visible to the session.
ProtectProc=invisible
ProcSubset=pid
