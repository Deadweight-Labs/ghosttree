[Unit]
Description=ghosttree context server
After=network-online.target
Wants=network-online.target

[Service]
User=ghosttree
DynamicUser=yes
StateDirectory=ghosttree
Environment=GHOSTTREE_LISTEN=127.0.0.1:8474
EnvironmentFile=-/etc/ghosttree/server.env
ExecStart=/usr/local/bin/ctx serve --db /var/lib/ghosttree/ghosttree.db --listen ${GHOSTTREE_LISTEN}
Restart=on-failure

[Install]
WantedBy=multi-user.target
